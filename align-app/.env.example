# Jitsi Meet server pentru apeluri video.
# Implicit: meet.jit.si (server public). Pentru producție, pune domeniul tău Jitsi (ex. meet.taudomeniu.ro).
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# reCAPTCHA v3 (invisible) pentru signup. Obții cheile pe https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc...
# RECAPTCHA_SECRET_KEY=6Lc...

# URL-uri semnate pentru imagini/resurse premium (server-only, min. 16 caractere). Nu pune în client.
# SIGNED_URL_SECRET=your-secret-min-16-chars

# PostgreSQL – obligatoriu ca conturile să rămână (login/înregistrare). Fără el, conturile se pierd la repornire.
# După ce pui asta, rulează: npm run db:setup
# DATABASE_URL=postgresql://user:password@localhost:5432/align

# NextAuth (secret pentru sesiuni)
# NEXTAUTH_SECRET=min-32-chars-random-string
# NEXTAUTH_URL=http://localhost:3000
