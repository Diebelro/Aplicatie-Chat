# --- Apeluri WebRTC (DIEBEL) — playbook: docs/hetzner-production-playbook.md ---
# Vercel: setează aceleași valori în Production ȘI Preview (dacă testezi apeluri pe preview).
#
# Producție (exemplu — înlocuiește secretul; nu comite valori reale):
# NEXT_PUBLIC_SIGNALING_WS_URL="wss://ws.diebel.ro/ws"
# IMPORTANT Vercel: semnalizarea NU e pe același serverless — folosește host unde rulează
# `server/call-signaling-server.mjs` (wss://). `GET https://<app>/api/ws` e doar JSON info, nu WebSocket.
# Dacă ai nginx care mapează /api/ws → backend WS, poți seta ex. wss://chat.diebel.ro/api/ws
# TURN_REALM=turn.diebel.ro
# TURN_STATIC_SECRET=<set-on-server-only același ca static-auth-secret coturn>
# NEXT_PUBLIC_TURN_URLS=["stun:turn.diebel.ro:3478","turn:turn.diebel.ro:3478?transport=udp","turns:turn.diebel.ro:5349?transport=tcp"]
# (în .env local poți folosi și ghilimele simple în jurul JSON-ului pentru NEXT_PUBLIC_TURN_URLS)
# TURN_AUTH_SECRET=<pentru signaling-token / webrtcConfig; poate fi aceeași valoare ca TURN_STATIC_SECRET>
# SIGNALING_TOKEN_SECRET=<min 16; același ca pe VPS .env.signaling sau folosește NEXTAUTH_SECRET>
# CALL_MAX_MINUTES=30
# CALL_MAX_BITRATE_DESKTOP=2500000
# CALL_MAX_BITRATE_MOBILE=1200000
# NEXT_PUBLIC_FEATURE_SCREENSHARE=true
# FEATURE_SCREENSHARE=true
# NEXT_PUBLIC_WEBRTC_ENABLED=true
#
# Dev — semnalizare locală (fără TLS):
# NEXT_PUBLIC_SIGNALING_WS_URL=ws://127.0.0.1:4001
# npm run signaling:dev  (port 4001)
#
# TODO fără DNS: în TURN_URLS poți folosi temporar IP public Hetzner; NU continua TLS Let’s Encrypt până nslookup pentru domeniu e OK.
# Dev: strict http://localhost:3005 (npm run dev); NU https:// → „invalid response”. Dacă portul e ocupat: npm run ports:free

# Jitsi (legacy — CallUI folosește WebRTC; poți ignora dacă ai coturn + signaling)
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# reCAPTCHA v3 (invisible) pentru signup. Obții cheile pe https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc...
# RECAPTCHA_SECRET_KEY=6Lc...

# URL-uri semnate pentru imagini/resurse premium (server-only, min. 16 caractere). Nu pune în client.
# SIGNED_URL_SECRET=your-secret-min-16-chars

# PostgreSQL (Neon). În producție: Vercel → Environment Variables.
# În dev: dacă setezi DATABASE_URL, aplicația folosește Prisma (date persistente). Fără el → store în memorie.
# DATABASE_URL=postgresql://...

# Doar pentru scriptul npm run db:ensure-contact (nu comite valoarea). Exemplu: $env:CONTACT_PASSWORD="***"
# CONTACT_PASSWORD=
# CONTACT_EMAIL=contact@diebel.ro

# URL-ul public al aplicației. Obligatoriu în producție (Vercel: https://numele-proiectului.vercel.app sau domeniu custom).
# Folosit la link-uri din email (ex. reset parolă), OAuth, etc.
# Producție chat.diebel.ro: NEXT_PUBLIC_APP_URL=https://chat.diebel.ro
# NEXT_PUBLIC_APP_URL=https://numele-tau.vercel.app

# NextAuth (secret pentru sesiuni)
# NEXTAUTH_SECRET=min-32-chars-random-string
# Local: npm rulează pe port fix 3005 — aliniază URL-urile:
# NEXTAUTH_URL=http://localhost:3005
# NEXT_PUBLIC_APP_URL=http://localhost:3005
# Producție chat.diebel.ro: NEXTAUTH_URL=https://chat.diebel.ro (același host ca NEXT_PUBLIC_APP_URL)

# Vercel Blob – atașamente chat (poze + PDF). Creează două store-uri: unul public (imagini), unul private (PDF).
# BLOB_READ_WRITE_TOKEN=...   (store public pentru imagini)
# BLOB_READ_WRITE_TOKEN_PDF=... (store private pentru PDF)

# Mod test (20 conturi): feed-ul nu exclude profilele deja swipe-uite; fiecare profil vine cu hasLiked/hasDisliked/isMatched/hasMessages. Default: false.
# TEST_MODE=true

# Monetizare mesaje: când e true, doar utilizatorii cu abonament activ pot trimite mesaje. Implicit: false (mesajele sunt gratuite).
# MESSAGING_PAYWALL_ENABLED=false
