# =============================================================================
# PRODUCȚIE (Vercel Production + chat.diebel.ro) — obligatoriu pe host, nu în git
# =============================================================================
# NEXTAUTH_URL=https://chat.diebel.ro
# NEXT_PUBLIC_APP_URL=https://chat.diebel.ro
# PUBLIC_APP_URL=https://chat.diebel.ro
# DATABASE_URL=<Neon pooled>
# DIRECT_URL=<Neon direct>
# EXPECTED_DB_ENV=prod
# NEXT_PUBLIC_SIGNALING_WS_URL=wss://ws.diebel.ro/ws
# NEXT_PUBLIC_TURN_URLS='["stun:turn.diebel.ro:3478","turn:turn.diebel.ro:3478?transport=udp","turns:turn.diebel.ro:5349?transport=tcp"]'
# TURN_REALM=turn.diebel.ro
# TURN_STATIC_SECRET=<identic cu static-auth-secret coturn — obligatoriu pentru GET /api/call/ice-config>
# TURN_AUTH_SECRET=<≥16; de obicei = TURN_STATIC_SECRET; validare webrtc + envLayerComplete (HMAC ICE e doar TURN_STATIC_SECRET)>
# SIGNALING_TOKEN_SECRET=<același ca pe VPS semnalizare; sau NEXTAUTH_SECRET ≥ 16>
# Fără acestea, WebRTC nu merge pe net (browser sau TWA / iOS wrapper).
#
# =============================================================================
# LOCAL ca VERCEL (video, TURN, mail) — același cod, aceleași variabile de mediu
# =============================================================================
# Din folderul align-app (o singură dată: npx vercel login && npx vercel link):
#   npm run env:pull-production
# → creează .env.local cu toate variabilele din Vercel Production (.env.local e în .gitignore).
#
# Fără CLI: copiază manual din Vercel → Project → Settings → Environment Variables → Production
# într-un fișier .env.local (nu comita).
#
# Dacă NEXT_PUBLIC_SIGNALING_WS_URL e wss://... (producție), NEXTAUTH_SECRET sau
# SIGNALING_TOKEN_SECRET trebuie să fie ACELAȘI ca pe Vercel și pe VPS-ul de semnalizare,
# altfel token-ul WebSocket e invalid și nu pornește apelul.
#
# Testează apeluri pe http://localhost:3005 (camera nu merge bine pe http://IP-LAN fără HTTPS).
#
# La `npm run dev`, browserul se deschide pe http://localhost:3005/ (aliniat cu NEXTAUTH_URL). Altă pagină: ALIGN_DEV_OPEN=http://localhost:3005/admin/setup
# Fără deschidere automată: npm run dev:quiet
#
# După pull, Vercel poate avea NEXTAUTH_URL=https://... (producție). Pentru login local,
# pune la SFÂRȘITUL lui .env.local (suprascrie valorile trase):
#   NEXTAUTH_URL=http://localhost:3005
#   NEXT_PUBLIC_APP_URL=http://localhost:3005
# (Păstrează restul: SIGNALING, TURN, RESEND, DATABASE_URL, etc.)
# =============================================================================
#
# Opțional: identificator build în watermark / health (max 16 caractere).
# Lăsat gol, local = primii 16 din `git rev-parse HEAD`, pe Vercel = VERCEL_GIT_COMMIT_SHA.
# NEXT_PUBLIC_BUILD_HASH=
#
# =============================================================================

# --- Apeluri WebRTC (DIEBEL) — playbook: docs/hetzner-production-playbook.md ---
# Vercel: setează aceleași valori în Production ȘI Preview (dacă testezi apeluri pe preview).
#
# Producție (exemplu — înlocuiește secretul; nu comite valori reale):
# NEXT_PUBLIC_SIGNALING_WS_URL="wss://ws.diebel.ro/ws"
# IMPORTANT Vercel: semnalizarea NU e pe același serverless — folosește host unde rulează
# `server/call-signaling-server.mjs` (wss://). `GET https://<app>/api/ws` e doar JSON info, nu WebSocket.
# Dacă ai nginx care mapează /api/ws → backend WS, poți seta ex. wss://chat.diebel.ro/api/ws
# TURN_REALM=turn.diebel.ro
# TURN_STATIC_SECRET=<set-on-server-only același ca static-auth-secret coturn>
# NEXT_PUBLIC_TURN_URLS=["stun:turn.diebel.ro:3478","turn:turn.diebel.ro:3478?transport=udp","turns:turn.diebel.ro:5349?transport=tcp"]
# (în .env local poți folosi și ghilimele simple în jurul JSON-ului pentru NEXT_PUBLIC_TURN_URLS)
# TURN_AUTH_SECRET=<pentru signaling-token / webrtcConfig; poate fi aceeași valoare ca TURN_STATIC_SECRET>
# SIGNALING_TOKEN_SECRET=<min 16; același ca pe VPS .env.signaling sau folosește NEXTAUTH_SECRET>
# CALL_MAX_MINUTES=30
# CALL_MAX_BITRATE_DESKTOP=2500000
# CALL_MAX_BITRATE_MOBILE=1200000
# NEXT_PUBLIC_FEATURE_SCREENSHARE=true
# FEATURE_SCREENSHARE=true
# NEXT_PUBLIC_WEBRTC_ENABLED=true
#
# --- Firebase Cloud Messaging — apeluri native Android (trimis la POST /api/call/ring) ---
# Creează proiect Firebase → Project settings → Service accounts → Generate new private key (JSON).
# Pe Vercel: copiază project_id, client_email, private_key în variabile (private_key cu newline-uri ca \n).
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# (Poți lăsa valoarea între ghilimele în Vercel — codul normalizează PEM-ul; \n trebuie rămas literal în string.)
#
# --- APNs VoIP (PushKit) — iOS nativ; cheie .p8 din Apple Developer → Keys ---
# APNS_KEY_ID=ABCD123456
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.align.app
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APNS_USE_SANDBOX=true   # development builds iOS; producție: false sau omit
#
# --- Web Push (browser) — apel intrare; Push API + VAPID. Fără aceste variabile, ring-ul nu trimite Web Push. ---
# Generează: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNx...   (publică, în client pentru pushManager.subscribe)
# VAPID_PRIVATE_KEY=...                  (secret server-only)
# VAPID_SUBJECT=mailto:support@domeniu.tld   (sau VAPID_CONTACT= același lucru; contact pentru serviciul push)
# Notă: Push merge pe HTTPS sau localhost; utilizatorul trebuie să permită notificări. Nu rulăm WebRTC în service worker.
#
# Dev — semnalizare locală (fără TLS):
# NEXT_PUBLIC_SIGNALING_WS_URL=ws://127.0.0.1:4001
# npm run signaling:dev  (port 4001)
#
# TODO fără DNS: în TURN_URLS poți folosi temporar IP public Hetzner; NU continua TLS Let’s Encrypt până nslookup pentru domeniu e OK.
# Dev: strict http://localhost:3005 (npm run dev); NU https:// → „invalid response”. Dacă portul e ocupat: npm run ports:free

# Jitsi (legacy — CallUI folosește WebRTC; poți ignora dacă ai coturn + signaling)
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# reCAPTCHA v3 (invisible) pentru signup. Obții cheile pe https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc...
# RECAPTCHA_SECRET_KEY=6Lc...

# URL-uri semnate pentru imagini/resurse premium (server-only, min. 16 caractere). Nu pune în client.
# SIGNED_URL_SECRET=your-secret-min-16-chars

# PostgreSQL (Neon). DEV și PROD: proiecte / connection string-uri SEPARATE.
# În dev: dacă setezi DATABASE_URL, aplicația folosește Prisma. Fără el → store în memorie.
#
# ─── Obligatoriu cu schema Prisma actuală ─────────────────────────────────────
# DATABASE_URL  = runtime (Neon: „Pooled” / host cu „-pooler” pe serverless)
# DIRECT_URL    = migrări & Prisma CLI (Neon: „Direct” / host FĂRĂ „-pooler”) — evită P1002 la advisory lock
# Ambele trebuie setate în .env / .env.local (și pe Vercel pentru `prisma generate` la build).
#
# Ordinea dotenv în npm scripts: .env.local are prioritate peste .env (fișierul listat PRIMUL la dotenv-cli@8).
#
# Guardrails: `node scripts/env-guard.mjs` (apelat automat la dev / start / db:*). Variabile utile:
#   EXPECTED_DB_ENV=dev              # local
#   EXPECTED_DB_ENV=prod             # Vercel Production
#   FORBIDDEN_PROD_DB_SUBSTRING=...  # local: fragment din host-ul DB de producție — blochează dacă e în URL
#   REQUIRED_PROD_DB_HOST_SUBSTRING=...  # producție: hostul trebuie să conțină acest fragment
#   DB_BLOCK_MARKERS_IN_PRODUCTION=-dev-,localhost  # subșiruri interzise în URL când NODE_ENV=production
#
# Recovery: docs/RECOVERY.md (PITR Neon, proiect șters în grace period)
# DATABASE_URL=postgresql://...@ep-xxx-pooler....neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://...@ep-xxx....neon.tech/neondb?sslmode=require

# Doar pentru scriptul npm run db:ensure-contact (nu comite valoarea). Exemplu: $env:CONTACT_PASSWORD="***"
# CONTACT_PASSWORD=
# CONTACT_EMAIL=contact@diebel.ro
#
# Opțional: forțează explicit un singur email ca admin automat la login + /api/me (altfel se folosește CONTACT_EMAIL de mai sus).
# Pe Vercel pune același email ca al contului tău principal — fără script grant-admin.
# ADMIN_OWNER_EMAIL=contact@diebel.ro

# URL în browser (client). La dev poate fi http://localhost:3005
# NEXT_PUBLIC_APP_URL=http://localhost:3005
#
# Link-uri în EMAIL (reset, verificare):
# - opțional EMAIL_PUBLIC_APP_URL — baza folosită doar în linkurile din email (override tuturor)
# - apoi PUBLIC_APP_URL (server-only), apoi NEXT_PUBLIC_APP_URL
# Producție chat pe Vercel: https://chat.diebel.ro (NU doar https://diebel.ro — certificat/site firmă ≠ app)
# EMAIL_PUBLIC_APP_URL=https://chat.diebel.ro
# PUBLIC_APP_URL=https://chat.diebel.ro
# NEXT_PUBLIC_APP_URL=https://chat.diebel.ro
# Pe Vercel Production: setează NEXT_PUBLIC_APP_URL la URL-ul canonic al app-ului (același ca NEXTAUTH_URL),
# ca robots/sitemap/metadataBase să nu rămână pe fallback-ul din cod.
# Dacă din greșeală PUBLIC_APP_URL=https://diebel.ro, în production codul forțează chat.diebel.ro
# (dezactivezi cu DISABLE_DIEBEL_APEX_EMAIL_REDIRECT=1 dacă ai nevoie excepție).

# Email (Resend) — reset parolă, verificare la signup, /api/dev/resend-test
# https://resend.com → Domains: adaugă diebel.ro, DNS în Hetzner, Verify până e „Verified”.
# RESEND_API_KEY=re_...
# Implicit în cod (dacă nu setezi RESEND_FROM_EMAIL): Align <contact@diebel.ro>
# Poți seta explicit:
# RESEND_FROM_EMAIL=Align <contact@diebel.ro>
# Test rapid fără domeniu propriu: RESEND_FROM_EMAIL=onboarding@resend.dev (limite Resend).
#
# Test email (doar development): POST /api/dev/resend-test cu body {"to":"tu@email.com"}
# Opțional protecție dev: RESEND_TEST_SECRET=... și header x-resend-test-secret la același request.
# În producție, /api/dev/resend-test răspunde 404 decât dacă setezi RESEND_TEST_SECRET + header.

# NextAuth (secret pentru sesiuni)
# NEXTAUTH_SECRET=min-32-chars-random-string
# Local: npm rulează pe port fix 3005 — aliniază URL-urile:
# NEXTAUTH_URL=http://localhost:3005
#
# Hostul din browser trebuie să coincidă cu NEXTAUTH_URL (http/https, localhost vs 127.0.0.1, port).
# Debug: AUTH_DEBUG=1 → loguri NextAuth în terminal + detalii Prisma la login eșuat.
# În dev: GET /api/auth/diag — verifică NEXTAUTH_*, Prisma ping (fără secrete în JSON).
# NEXT_PUBLIC_APP_URL=http://localhost:3005
#
# Recuperare parolă prin scan pe telefon (dev): localhost pe telefon nu e PC-ul tău.
# 1) Pornește: npm run dev:lan
# 2) ipconfig → IPv4 (ex. 192.168.1.10)
# 3) În .env: NEXT_PUBLIC_MOBILE_RECOVER_ORIGIN=http://192.168.1.10:3005
# 4) Repornește dev; QR / linkul vor folosi IP-ul din rețea (telefon pe același Wi‑Fi).
# NEXT_PUBLIC_MOBILE_RECOVER_ORIGIN=http://192.168.1.10:3005
#
# Chrome pe telefon poate forța HTTPS la IP local → „conexiunea nu e privată”. Soluție sigură:
# În al 2-lea terminal (cu dev:lan pornit): npm run tunnel:lt → copiezi URL https://….loca.lt în:
# NEXT_PUBLIC_MOBILE_RECOVER_ORIGIN=https://subdomain.loca.lt
# (fără slash final). Repornești dev și regenerezi QR.
# Producție chat.diebel.ro: NEXTAUTH_URL=https://chat.diebel.ro (același host ca NEXT_PUBLIC_APP_URL)
#
# --- OAuth (NextAuth) — opțional; butoanele devin active când setezi perechile de mai jos ---
# În consola fiecărui provider, autorizează redirect URI: {NEXTAUTH_URL}/api/auth/callback/{provider}
# Ex. Google: …/api/auth/callback/google   Microsoft (Azure AD): …/api/auth/callback/azure-ad
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_ID=          (Services ID)
# APPLE_SECRET=      (JWT client secret generat — vezi documentația Apple Sign In)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common   (opțional; default common)
# Telefon (SMS) și Yahoo Mail: încă nu sunt implementate — butonul duce la mesaj „în curând”.

# Vercel Blob – atașamente chat pe producție / preview (VERCEL=1). Fără token-uri, pozele nu merg în cloud.
# Creează store-uri în Vercel Dashboard → Storage → Blob și lipești token-urile în Environment Variables.
# BLOB_READ_WRITE_TOKEN=...   (imagini chat: Blob private; acces doar prin /api/chat/attachment)
# BLOB_READ_WRITE_TOKEN_PDF=... (PDF în chat: Blob private)
#
# Local (npm run dev, fără VERCEL): pozele merg în public/_chatDev; în chat se afișează prin /api/chat/attachment (nu expunem URL brut în API).
# PDF în chat pe local tot cere BLOB_READ_WRITE_TOKEN_PDF sau folosești doar imagini în dev.
# Dezactivează explicit discul local: CHAT_LOCAL_UPLOAD=false
# Forțează discul local și pe alte medii (ex. server propriu fără VERCEL): CHAT_LOCAL_UPLOAD=true

# Mod test (20 conturi): feed-ul nu exclude profilele deja swipe-uite; fiecare profil vine cu hasLiked/hasDisliked/isMatched/hasMessages. Default: false.
# TEST_MODE=true

# Monetizare mesaje: când e true, doar utilizatorii cu abonament activ pot trimite mesaje. Implicit: false (mesajele sunt gratuite).
# MESSAGING_PAYWALL_ENABLED=false

# Stripe — ID-uri Price din Dashboard (lib/subscriptionPlans.ts). Fără ele, fluxul de plată nu are planuri.
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_SIX_MONTH=price_...
# STRIPE_PRICE_YEARLY=price_...

# LIVE (MVP): banda „site în lucru” apare DOAR dacă valoarea e exact `true`. Lipsă / false / altceva = afișare oprită.
# Nu seta pe Vercel Production pentru go-live. Preview/staging: NEXT_PUBLIC_SHOW_WIP_BANNER=true
# NEXT_PUBLIC_SHOW_WIP_BANNER=true

# Butoane Google/Apple/etc. pe login/signup. Ascunde tot cu: NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false
# Fără variabile OAuth de mai sus → butonul apare estompat (nu e configurat pe server).
# NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false

# Tracking (încărcare scripturi doar dacă valorile par reale, nu placeholder). Opțional:
# NEXT_PUBLIC_GA4_ID=G-xxxxxxxxxx
# NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
# NEXT_PUBLIC_GOOGLE_ADS_ID=ca-pub-1234567890123456

# Ops — alertă când bordul e „critical” (webhook JSON). În dev nu trimite decât cu OPS_CRITICAL_NOTIFY_IN_DEV=1
# OPS_CRITICAL_WEBHOOK_URL=https://hooks.slack.com/... sau Discord webhook
# OPS_CRITICAL_WEBHOOK_SECRET=...  (opțional → header Authorization: Bearer)
# OPS_CRITICAL_NOTIFY_COOLDOWN_MS=900000  (default 15 min; același mesaj nu se repetă mai des)
# OPS_CRITICAL_NOTIFY_IN_DEV=1
#
# Puls fără admin deschis: GET /api/cron/ops-pulse?secret=... sau Authorization: Bearer ...
# OPS_CRON_SECRET=min-32-chars-random  (sau CRON_SECRET ca pe Vercel Cron — același header Bearer)
# Apelare: la 5–15 min din UptimeRobot/crontab cu URL + ?secret=..., sau Vercel Cron (Pro: frecvență mai mare; Hobby: max. zilnic).

# Admin — raport AI la /admin/moderation-scan (doar sugestii; fără acțiuni automate). Opțional:
# OPENAI_API_KEY=sk-...
# OPENAI_MODERATION_MODEL=gpt-4o-mini
#
# =============================================================================
# Android TWA / Google Play — Digital Asset Links (/.well-known/assetlinks.json)
# =============================================================================
# După primul .aab: Play Console → App integrity → App signing → SHA-256 fingerprint + package name.
#   ANDROID_TWA_PACKAGE_NAME=ro.diebel.chat.twa
#   ANDROID_TWA_SHA256_FINGERPRINTS=14:6D:E9:...   (sau hex fără : ; mai multe separate prin virgulă)
# Fără variabile, ruta returnează JSON [] (valid). Cu variabile, `GET https://chat.diebel.ro/.well-known/assetlinks.json`
# servește statement-ul pentru verificarea domeniului în TWA.

