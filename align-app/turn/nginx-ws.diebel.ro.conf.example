# Exemplu vhost Nginx pentru semnalizare WebRTC: wss://ws.diebel.ro/ws
# Copiază în sites-available, adaptează căile, apoi: nginx -t && systemctl reload nginx
#
# Certificat Let's Encrypt (aceleași căi ca certbot):
#   /etc/letsencrypt/live/ws.diebel.ro/fullchain.pem
#   /etc/letsencrypt/live/ws.diebel.ro/privkey.pem
#
# Upstream: call-signaling-server.mjs pe 127.0.0.1:4001 (SIGNALING_PORT implicit 4001)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ws.diebel.ro;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ws.diebel.ro;

    ssl_certificate     /etc/letsencrypt/live/ws.diebel.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ws.diebel.ro/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Health HTTP al procesului Node (call-signaling-server.mjs)
    location = /health {
        proxy_pass http://127.0.0.1:4001/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket semnalizare (?token=... la handshake)
    location /ws {
        proxy_pass http://127.0.0.1:4001/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Doar semnalizare pe acest host — restul 404
    location / {
        return 404;
    }
}
