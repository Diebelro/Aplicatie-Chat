# =============================================================================
# Diebel — variabile de PRODUCȚIE pe VPS (Docker). Copiază în `.env.production`
# și completează valorile reale. NU comite `.env.production` (e în .dockerignore).
#   cp .env.production.example .env.production && nano .env.production
# =============================================================================

# --- URL-uri publice (toate pe chat.diebel.ro) ------------------------------
NEXTAUTH_URL=https://chat.diebel.ro
NEXT_PUBLIC_APP_URL=https://chat.diebel.ro
PUBLIC_APP_URL=https://chat.diebel.ro
EMAIL_PUBLIC_APP_URL=https://chat.diebel.ro

# --- Secrete sesiune --------------------------------------------------------
# Generează: openssl rand -base64 48
NEXTAUTH_SECRET=

# --- Baza de date Postgres (Neon — extern, NU Vercel) -----------------------
# DATABASE_URL = host „-pooler” (runtime). DIRECT_URL = host direct (migrări).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
EXPECTED_DB_ENV=prod

# --- Atașamente chat pe disc (în loc de Vercel Blob) ------------------------
# Volumul `chat_uploads` din docker-compose persistă /app/public/_chatDev.
CHAT_LOCAL_UPLOAD=true

# --- WebRTC: semnalizare + TURN ---------------------------------------------
NEXT_PUBLIC_SIGNALING_WS_URL=wss://ws.diebel.ro/ws
# Secret comun aplicație <-> server signaling (min 16). Poate fi = NEXTAUTH_SECRET.
SIGNALING_TOKEN_SECRET=
# Origin permis la handshake WS (pagina care deschide WebSocket-ul).
SIGNALING_ALLOWED_ORIGINS=https://chat.diebel.ro

# coturn (rămâne separat pe VPS, turn.diebel.ro)
NEXT_PUBLIC_TURN_URLS=["stun:turn.diebel.ro:3478","turn:turn.diebel.ro:3478?transport=udp","turns:turn.diebel.ro:5349?transport=tcp"]
TURN_REALM=turn.diebel.ro
TURN_STATIC_SECRET=
TURN_AUTH_SECRET=
NEXT_PUBLIC_WEBRTC_ENABLED=true
CALL_MAX_MINUTES=30
CALL_MAX_BITRATE_DESKTOP=2500000
CALL_MAX_BITRATE_MOBILE=1200000

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Diebel <contact@diebel.ro>

# --- Web Push (apel intrare în browser) -------------------------------------
# Generează: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@diebel.ro

# --- Firebase (apeluri native Android, POST /api/call/ring) -----------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Admin ------------------------------------------------------------------
ADMIN_OWNER_EMAIL=contact@diebel.ro

# --- OAuth (opțional; lasă gol dacă nu folosești) ---------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Android TWA / assetlinks (opțional) ------------------------------------
# ANDROID_TWA_PACKAGE_NAME=ro.diebel.chat
# ANDROID_TWA_SHA256_FINGERPRINTS=
