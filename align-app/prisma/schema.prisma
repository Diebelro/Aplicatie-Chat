generator client {
  provider = "prisma-client-js"
  /// Local (Windows/Mac) + Docker Linux (debian slim, OpenSSL 3) pentru deploy pe VPS.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Conexiune directă (fără -pooler) — folosită de Prisma migrate / db push / introspect (recomandare Neon + Prisma).
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  emailVerified DateTime?
  role         String   @default("USER")
  isBanned     Boolean  @default(false)
  /// Dacă e în viitor: suspendare temporară — la expirare, login /api/me eliberează automat accesul.
  banUntil     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile?
  locations    Location[]
  swipesFrom   Swipe[]  @relation("SwipeFrom")
  swipesTo     Swipe[]  @relation("SwipeTo")
  matchesA     Match[]  @relation("MatchA")
  matchesB     Match[]  @relation("MatchB")
  messagesFrom Message[] @relation("MessageFrom")
  messagesTo   Message[] @relation("MessageTo")
  premiumSubscriptions PremiumSubscription[]
  boosts       Boost[]
  deviceFingerprints DeviceFingerprint[]
  blocksInitiated Block[] @relation("Blocker")
  blocksReceived  Block[] @relation("Blocked")
  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")
  appFeedback     AppFeedback[]
  adminLogs       AdminLog[]
  visitsAsViewer  Visit[]  @relation("VisitViewer")
  visitsAsProfile Visit[]  @relation("VisitProfile")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  banAppeals BanAppeal[]
  sessions   UserSession[]
  pushDevices UserPushDevice[]
  webPushSubscriptions WebPushSubscription[]
  missedCallsReceived MissedCall[]
}

/// Push API (VAPID) — notificări apel în browser; fără WebRTC în Service Worker.
model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Token push per dispozitiv: FCM (Android) și/sau APNs VoIP PushKit (iOS).
model UserPushDevice {
  id             String    @id @default(cuid())
  userId         String
  /// Android — Firebase Cloud Messaging
  fcmToken       String?   @unique
  /// iOS — PushKit VoIP token (hex), trimis la APNs cu apns-push-type: voip
  apnsVoipToken  String?   @unique
  /// android | ios
  platform       String    @default("android")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sesiune login (token = valoarea cookie align_sid / x-session-token). Persistată pentru Vercel / mai multe instanțe.
model UserSession {
  token     String   @id
  userId    String
  deviceId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Contestare blocare cont (user crede că a fost blocat nedrept).
model BanAppeal {
  id         String    @id @default(cuid())
  userId     String
  message    String
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Token hash (SHA-256) pentru verificare email la înregistrare.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Token hash (SHA-256) pentru resetare parolă; valoarea brută există doar în email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String    @default("")
  username              String    @unique
  realName              String?
  bio                   String    @default("")
  birthDate             String?
  gender                String?
  country               String?
  city                  String?
  postalCode            String?
  educationLevel        String?
  occupation            String?
  maritalStatus         String?
  wantsChildren         String?
  height                Int?
  weight                Int?
  eyeColor              String?
  hairColor             String?
  bodyType              String?
  clothingStyle         String?
  distinctiveFeatures   String?
  physicalAsset        String?
  physicalAssetDetail  String?
  partnerPhysicalPreferences String?
  partnerLifestyle      String?
  partnerDealBreakers   String?
  showDistance          Boolean   @default(true)
  showOnline            Boolean   @default(true)
  showProfileVisits    Boolean   @default(true)
  showReadReceipts     Boolean   @default(true)
  allowFriendRequests  Boolean   @default(true)
  completedAt           DateTime?
  lastActiveAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  photos                ProfilePhoto[]
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  url       String
  createdAt DateTime @default(now())
}

model Location {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  /// Vizibil pe hartă doar până la acest moment (setat explicit de user, durată 15 min–3 h).
  mapVisibleUntil DateTime?
  updatedAt DateTime @updatedAt
}

model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  fromUser   User     @relation("SwipeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("SwipeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  liked      Boolean
  createdAt  DateTime @default(now())
  // @default(now()) umple rândurile existente la push; @updatedAt actualizează la modificări
  updatedAt  DateTime @default(now()) @updatedAt
  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id                    String   @id @default(cuid())
  fromUserId            String
  toUserId              String
  fromUser              User     @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser                User     @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  text                  String   @default("")
  attachmentUrl         String?
  attachmentContentType String?
  status                String   @default("SENT")
  createdAt             DateTime @default(now())
  deliveredAt           DateTime?
  seenAt                DateTime?
  /// Afișat în chat ca notificare de sistem (moderare), nu ca mesaj de la interlocutor.
  isPlatformNotice      Boolean  @default(false)
  /// După această dată notificarea nu mai e returnată în API-uri de chat (null = vechi, fără expirare).
  platformNoticeExpiresAt DateTime?
  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
}

model PremiumSubscription {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  status           String   @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([userId])
}

model Boost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model DeviceFingerprint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  userAgent   String?
  ip          String?
  trusted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([userId, fingerprint])
  @@index([userId])
}

model RateLimitLog {
  id        String   @id @default(cuid())
  identifier String
  endpoint  String
  count     Int      @default(1)
  windowStart DateTime
  createdAt DateTime @default(now())
  @@index([identifier, endpoint])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  createdAt  DateTime @default(now())
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  @@index([reporterId])
  @@index([reportedId])
}

/// Sugestii / feedback despre aplicație (nu sunt rapoarte împotriva unui user).
model AppFeedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  pageUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Visit {
  id            String   @id @default(cuid())
  viewerUserId  String
  profileUserId String
  createdAt     DateTime @default(now())
  /// Ultima deschidere a profilului de către vizitator (pereche unică în DB).
  lastVisitedAt DateTime @default(now())
  viewer        User     @relation("VisitViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  profileUser   User     @relation("VisitProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  @@unique([viewerUserId, profileUserId])
  @@index([viewerUserId])
  @@index([profileUserId])
  @@index([profileUserId, lastVisitedAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  details   String? // motiv/note (ex. BAN), opțional
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

// Apel 1-la-1 în așteptare (callee). Pe Vercel memoria nu e partajată — DB e sursa de adevăr.
model PendingIncomingCall {
  toUserId  String   @id
  fromId    String
  roomId    String
  audioOnly Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Respingere apel (roomId) — persistat pentru Vercel (polling caller pe altă instanță decât reject).
model RejectedCallRoom {
  roomId    String   @id
  createdAt DateTime @default(now())
}

/// Apel acceptat (roomId) — până la /end; apelantul nu vede „indisponibil” între accept și conectarea WebRTC.
model AnsweredCallRoom {
  roomId    String   @id
  createdAt DateTime @default(now())
}

/// Apel pierdut (callee nu a răspuns): TTL pending expirat sau apelant a închis înainte de răspuns.
model MissedCall {
  id        String   @id @default(cuid())
  /// Dedupe între TTL și ștergere pending la room (aceeași cameră = același apel).
  roomId    String   @unique
  toUserId  String
  fromId    String
  audioOnly Boolean  @default(false)
  ringAt    DateTime /// Când a început soneria (PendingIncomingCall.createdAt).
  toUser    User     @relation(fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, ringAt])
}
