# Copiază în .env.local (nu se comite). Ordine recomandată: .env.local are prioritate peste .env (dotenv-cli: fișier listat primul).

# ─── Google OAuth + NextAuth (set in Vercel Production env vars) ───────────
# Local dev: same names — NEXTAUTH_URL = this app origin; NEXTAUTH_SECRET = random 32+ chars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# ─── Mediu DB (obligatoriu) ─────────────────────────────────────────────────
# Proiecte Neon SEPARATE pentru dev vs prod (vezi docs/RECOVERY.md).
EXPECTED_DB_ENV=dev

# Runtime aplicație — Neon „Pooled connection” (host cu „-pooler”)
DATABASE_URL=

# Prisma migrate / db push / generate — Neon „Direct connection” (host fără „-pooler”)
DIRECT_URL=

# Opțional: fragment unic din host-ul DB de PROD pe care vrei să-l refuzi în dev
# FORBIDDEN_PROD_DB_SUBSTRING=ep-prod-endpoint-id

# Opțional: markeri suplimentari interziși când EXPECTED_DB_ENV=dev (listă separată prin virgulă)
# PROD_URL_MARKERS_IN_DEV=-prod-,ep-production

# ─── Apeluri / conferință WebRTC (local) ───────────────────────────────────
# `npm run dev` pornește automat și semnalizarea pe port 4001 (oprește cu același Ctrl+C ca Next).
# La fel: `npm run dev:quiet` / `npm run dev:lan` (fără browser / ascultă pe LAN).
# La `npm run dev:lan`, în terminal apare un chenar cu IP + valorile recomandate pentru .env.local (alt laptop).
# Scripturi dev (inclusiv dev:internet pe Windows): recomandat Node.js 20.x LTS (vezi .nvmrc și package.json engines).
# Pe internet din dev (HTTPS+WSS, fără editare .env): `npm run dev:internet` sau `npm run dev:online` / `npm run public:dev` (localtunnel).
# Dezactivare: ALIGN_DEV_NO_SIGNALING=1
# NEXT_PUBLIC_*: opțional în dev — next.config injectează ws://127.0.0.1:4001 dacă lipsește.
# `/api/call/ice-config` cere TURN: NEXT_PUBLIC_TURN_URLS (JSON array sau liste separate prin virgulă, cu cel puțin un turn:/turns:), TURN_REALM, TURN_STATIC_SECRET (același secret ca coturn static-auth-secret).
# Token semnalizare: în dev e suficient NEXTAUTH_SECRET (≥16); TURN_AUTH_SECRET pentru producție.
# Detalii: docs/calls.md
#
# NEXT_PUBLIC_SIGNALING_WS_URL=ws://127.0.0.1:4001
# SIGNALING_HEALTH_URL=https://ws.diebel.ro/health   # opțional prod; altfel https://<host WSS>/health
# NEXT_PUBLIC_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turns:127.0.0.1:5349?transport=tcp
# TURN_REALM=localhost
# TURN_STATIC_SECRET=inlocuieste-cu-32-caractere-hex!!
# TURN_AUTH_SECRET=inlocuieste-cu-32-caractere-hex!!

# ─── App URL (local) ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ─── DOAR recovery (DB nouă / pierdut admin) — NU în fluxul zilnic ─────────
# După ce ai restaurat contul: npm run cleanup (îți scoate BOOTSTRAP_* din .env.local).
# # BOOTSTRAP_ADMIN_EMAIL=contact@example.com
# # BOOTSTRAP_ADMIN_PASSWORD="parolă-între-ghilimele-dacă-conține-#-sau-$"
# # BOOTSTRAP_TEST_EMAIL= (opțional)
# # BOOTSTRAP_TEST_PASSWORD=
# # BOOTSTRAP_UPDATE_PASSWORD=1  (o dată, dacă userul există dar vrei alt hash)
# # BOOTSTRAP_ALLOW_PRODUCTION=1  (doar dacă chiziționezi bootstrap pe PROD)

# ─── Operațional (prod) ─────────────────────────────────────────────────────
# GET /api/health — monitor extern (200 ok; 503 = DB configurată dar down).
# OPS_CRITICAL_WEBHOOK_URL=          # opțional: webhook la stare critică în app
# OPS_CRITICAL_WEBHOOK_SECRET=       # opțional: Bearer
# OPS_CRITICAL_NOTIFY_COOLDOWN_MS=900000
# OPS_CRITICAL_NOTIFY_IN_DEV=1      # altfel nu trimite în development
