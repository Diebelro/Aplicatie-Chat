{
  "name": "align-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "verify-i18n": "node scripts/verify-i18n-keys.cjs",
    "postinstall": "prisma generate",
    "db:setup": "prisma generate && prisma db push",
