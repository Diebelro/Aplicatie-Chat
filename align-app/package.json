{
  "name": "align-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-and-open.mjs",
    "dev:server": "next dev -p 3005 --turbo",
    "dev:quiet": "next dev -p 3005 --turbo",
    "dev:lan": "next dev -p 3005 -H 0.0.0.0 --turbo",
    "tunnel:lt": "npx --yes localtunnel --port 3005",
    "dev:auto": "next dev",
    "ports:free": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/free-next-ports.ps1",
    "signaling:dev": "npx --yes dotenv-cli@8 -e .env -e .env.local -- node server/call-signaling-server.mjs",
    "env:pull-production": "npx --yes vercel@latest env pull .env.local --environment production",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-i18n": "node scripts/verify-i18n-keys.cjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:webrtc": "node scripts/verify-webrtc-production.mjs",
    "verify:webrtc:final": "node scripts/verify-webrtc-final.mjs",
    "verify:calls": "node scripts/verify-call-infra-remote.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:repair-win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/repair-prisma-win.ps1",
    "db:setup": "npm run db:generate && npx --yes dotenv-cli@8 -e .env -e .env.local -- prisma db push",
    "db:push": "npx --yes dotenv-cli@8 -e .env -e .env.local -- prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:ensure-contact": "ts-node --project scripts/tsconfig.json scripts/ensure-contact-user.ts",
    "db:grant-admin": "npx --yes dotenv-cli@8 -e .env -e .env.local -- node scripts/grant-admin.mjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^2.4.3",
    "firebase-admin": "^13.0.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "next": "^16.2.1",
    "next-auth": "^4.24.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.9.3",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
