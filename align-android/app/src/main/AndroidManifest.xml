<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- false = nu excludem tablete / dispozitive fără microfon din listing Play; permisiunea RECORD_AUDIO rămâne pentru apeluri. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission
        android:name="android.permission.MANAGE_OWN_CALLS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AlignApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_simple"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_simple"
        android:supportsRtl="true"
        android:theme="@style/Theme.Align"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <!-- FCM: google-services.json trebuie să fie real; altfel nu inițializăm Firebase la cold start. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- Evită crash la pornire dacă google-services.json e încă placeholder. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />

        <!-- Release: fără reclame (ADS_ENABLED=false). Oprim auto-init AdMob — altfel crash „Missing application ID” la pornire. -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            android:exported="false"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.Align"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.Align" />

        <activity
            android:name=".SecondaryScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.Align" />

        <activity
            android:name=".call.CallActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Align.Call" />

        <service
            android:name=".call.AlignConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <service
            android:name=".call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <service
            android:name=".fcm.AlignFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
